[Unit]
Description=Monitoring Server Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/systemd/monitoring-agent.conf
Environment=DAEMON_MODE=1
# WARNING: EnvironmentFile overrides the Environment= setting above. If
# /etc/monitoring-agent.conf contains DAEMON_MODE=0 (the old default in conf.example),
# the agent will run in one-shot mode and then exit, causing a restart loop
# due to systemd's Restart=always setting.
# Ensure DAEMON_MODE=1 is set in the config when using this daemon service.
ExecStart=/usr/local/bin/monitoring-agent.sh
Restart=always
RestartSec=5
TimeoutStartSec=20
UMask=0077
# ---------------------------------------------------------------------------
# NOTE: The namespace sandboxing directive below is DISABLED by default.
# On some VPS/containers (OpenVZ/LXC/Virtualizor, etc.), systemd cannot
# set up the mount namespace, causing the unit to fail to start with
# "status=226/NAMESPACE". If your server supports it, enable it (remove the #)
# for added security:
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/monitoring-agent
# ---------------------------------------------------------------------------
# Another optional hardening measure for busy servers:
# Nice=10
# IOSchedulingClass=idle
# CPUQuota=30%

[Install]
WantedBy=multi-user.target
