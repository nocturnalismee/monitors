MASTER_URL=https://monitor.yourdomain.com/api/push
SERVER_TOKEN=
SERVER_ID=
DAEMON_MODE=1
PUSH_INTERVAL=5
FAIL_RETRY_INTERVAL=15
FORCE_INTERVAL=30
DEADBAND_ENABLED=1
DEADBAND_CPU=0.5
DEADBAND_NETWORK_BPS=20000
DEADBAND_QUEUE=1
PANEL_PROFILE=auto
SIGN_REQUESTS=1
TIME_SYNC_ENABLED=1
TIME_SYNC_URL=https://monitor.yourdomain.com/api/time
TIME_SYNC_INTERVAL=900
TIME_OFFSET_FILE=/var/lib/monitoring-agent/monitoring-agent-time.offset
LOG_FILE=
LOG_MAX_BYTES=1048576
LAST_VALUES_FILE=/var/lib/monitoring-agent/last-values
CURL_TIMEOUT=10
CURL_SSL_OPTIONS=
NET_STATE_FILE=/var/lib/monitoring-agent/monitoring-agent-net.state
LOCK_FILE=/var/lib/monitoring-agent/monitoring-agent.lock
LOCK_WAIT_SECONDS=0
DEBUG_PAYLOAD=0
MAIL_QUEUE_SPOOL_FALLBACK=0
